// DETECTION: Password spraying (MITRE T1110.003)
// UNTESTED: validate in workspace before deploying.
// Sentinel scheduled analytics rule. Run every 1 hour, look back 1 hour. Severity: Medium.
// One source tries many different usernames with only a few guesses each, inside 10 minutes.
// Observed: 144.76.103.122 (Hetzner) tried 5,054 usernames, about 7 guesses per name.
// Excludes analyst IPs listed in the TrustedIPs watchlist (SearchKey = IP address); create it before deploying.
let TrustedIPs = (_GetWatchlist('TrustedIPs') | project SearchKey);
SecurityEvent
| where EventID == 4625 and IpAddress !in ("", "-") and IpAddress !in (TrustedIPs)
| summarize Accounts = dcount(Account), Attempts = count() by IpAddress, bin(TimeGenerated, 10m)
| where Accounts >= 20 and Attempts / Accounts < 3
| summarize SprayWindows = count(), MaxAccountsIn10Min = max(Accounts) by IpAddress
| order by MaxAccountsIn10Min desc
