// Username/password pairs tried against the Cowrie SSH honeypot.
// Credentials are parsed from the message text so this works even if
// the username/password columns were not mapped in the data collection rule.
let MyIP = "<your-home-ip>";
Cowrie_CL
| where eventid startswith "cowrie.login"
| where src_ip != MyIP
| extend creds = extract(@"\[(.*)\]", 1, message)
| extend user = tostring(split(creds, "/")[0]), pass = tostring(split(creds, "/")[1])
| summarize Attempts = count(), Succeeded = countif(eventid == "cowrie.login.success") by user, pass
| order by Attempts desc
