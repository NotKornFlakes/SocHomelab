// Attempts per hour per attacker and service. The timeline export behind the dashboard.
// Remove "IP" from the summarize and add "| render timechart" for a quick chart in Sentinel.
let MyIP = "<your-home-ip>";
union
  (SecurityEvent
   | where EventID == 4625 and IpAddress != MyIP and isnotempty(IpAddress) and IpAddress != "-"
   | project TimeGenerated, IP = IpAddress, Service = "RDP"),
  (Cowrie_CL
   | where eventid startswith "cowrie.login" and src_ip != MyIP
   | project TimeGenerated, IP = src_ip, Service = "SSH")
| where TimeGenerated > ago(7d)
| summarize Attempts = count() by bin(TimeGenerated, 1h), IP, Service
| order by TimeGenerated asc
